#!/usr/bin/env sh
# Verification for crap: everything CI runs, plus the checks CI cannot make for
# itself (its own workflow files, and a real run of the binary).
set -eu
cd "$(dirname "$0")/.."

# The same commands mise.toml hands to the reusable CI workflow.
cargo fmt --check
cargo clippy --all-targets -- -D warnings
cargo test --locked
cargo build --release --locked

# GitHub rejects a workflow file it cannot parse, which would take CI down with
# it — so this cannot be left to CI.
actionlint .github/workflows/*.yml
python3 .pi/check-workflows.py

tmp=$(mktemp)
trap 'rm -f "$tmp" "$tmp.patch"' EXIT

cargo run --quiet -- src --no-coverage --max-tokens 300 >"$tmp"
python3 - "$tmp" <<'PY'
import json, sys

text = open(sys.argv[1]).read()
doc = json.loads(text)
functions = doc["summary"]["functions"]
assert functions > 0, "scored no functions"
tokens = len(text) // 4
assert tokens <= 300, f"budget blown: {tokens} estimated tokens"
print(
    f"self-scan ok: {functions} functions, {doc['summary']['offenders']} offenders, "
    f"{tokens} estimated tokens"
)
PY

# Diff mode must narrow the report without changing what the summary measures.
# Target a line inside a real function, found rather than hardcoded, so the
# check cannot quietly go vacuous when report.rs shifts.
inside=$(grep -n 'pub fn render_json' src/report.rs | head -1 | cut -d: -f1)
test -n "$inside"
cat >"$tmp.patch" <<PATCH
--- a/src/report.rs
+++ b/src/report.rs
@@ -$inside,0 +$((inside + 1)) @@
+// one injected line
PATCH

cargo run --quiet -- src --no-coverage --diff-file "$tmp.patch" >"$tmp"
python3 - "$tmp" <<'PY'
import json, sys

doc = json.load(open(sys.argv[1]))
assert doc["diff"]["matched_files"] == 1, doc["diff"]
assert doc["diff"]["functions"] >= 1, "the patch landed inside no function"
assert doc["dropped"]["unchanged"] > 0, "diff mode withheld nothing"
assert doc["diff"]["functions"] < doc["summary"]["functions"], "diff did not narrow"
print(
    f"diff mode ok: {doc['diff']['functions']} changed of "
    f"{doc['summary']['functions']} functions"
)
PY

# The release archive must unpack to exactly the binary the Homebrew formula
# installs, at the root of the tarball.
stage=$(mktemp -d)
trap 'rm -rf "$stage" "$tmp" "$tmp.patch"' EXIT
cp target/release/crap "$stage/crap"
COPYFILE_DISABLE=1 tar -czf "$stage/crap_darwin_arm64.tar.gz" -C "$stage" crap
python3 - "$stage/crap_darwin_arm64.tar.gz" <<'PY'
import sys, tarfile

with tarfile.open(sys.argv[1]) as archive:
    names = [n.lstrip("./") for n in archive.getnames()]
assert names == ["crap"], f"archive holds {names}, expected ['crap']"
print(f"packaging ok: archive holds {names[0]}")
PY
